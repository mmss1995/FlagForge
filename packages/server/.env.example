PORT=4000
# Leave empty to use the in-memory store (data is lost on restart).
REDIS_URL=redis://localhost:6379
# Bearer token for the admin API and dashboard. Change it outside local development.
ADMIN_TOKEN=dev-admin-token
# Comma-separated environment keys created on first boot.
ENVIRONMENTS=development,staging,production
# Fixed SDK keys for first boot (demo only). The example apps expect this one.
SDK_KEYS=development=sdk-development-demo
# Origins allowed to call the SDK endpoints from a browser. "*" allows any.
SDK_CORS_ORIGINS=*
