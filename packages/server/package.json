{
  "name": "@flagforge/server",
  "version": "0.1.0",
  "description": "FlagForge API: flag management, audit log and real-time SDK streaming",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/index.ts",
    "build": "esbuild src/index.ts src/seed.ts --bundle --platform=node --format=esm --target=node22 --external:express --external:ioredis --external:zod --outdir=dist",
    "start": "node dist/index.js",
    "seed": "tsx --env-file-if-exists=.env.local src/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@flagforge/core": "*",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15"
  }
}
